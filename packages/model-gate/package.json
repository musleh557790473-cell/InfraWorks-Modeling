{
  "name": "@infraworks/model-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gate G3 - check an InfraWorks model after import against the package that was imported",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "model-gate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@infraworks/domain": "workspace:*",
    "@infraworks/imx-gate": "workspace:*",
    "adm-zip": "0.5.16",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
