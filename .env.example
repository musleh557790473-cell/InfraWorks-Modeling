# Local MVP mode — file store under ./data (independent of APS preview mode)
LOCAL_MODE=1

# Demo geometry generator only (scripts / generateDemoCollection). Never enables upload fabrication.
DEMO_MODE=0

# Preview product mode (server default when client omits previewMode):
#   local = Local free (default) — never call APS; DXF/local parse + 2D map
#   auto  = same default as local; health may show apsMode mock when keys empty
#   live  = prefer APS live preview (requires APS_CLIENT_ID + APS_CLIENT_SECRET)
APS_MODE=local

# Default CRS for LDIP / Al Narjis
DEFAULT_EPSG=32638

# Ports
# API also reverse-proxies the Next UI at / (open http://127.0.0.1:8787/ for the app)
API_PORT=8787
API_HOST=0.0.0.0
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
MCP_PORT=8790

# Storage (LOCAL_MODE uses ./data)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# ---------------------------------------------------------------------------
# Autodesk Platform Services (APS) — optional; only used when previewMode=aps
# Leave empty for Local free. With both set → live OAuth, OSS, MD, Viewer.
# ---------------------------------------------------------------------------
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Optional: 3-legged OAuth callback (not required for 2-legged OSS/MD/DA preview)
APS_CALLBACK_URL=http://127.0.0.1:8787/oauth/callback

# OSS bucket for CAD uploads (default: `{clientId}-infraworks` lowercased)
APS_BUCKET=

# Design Automation activity for DWG layer list / overlay normalize
# Example: `{APS_CLIENT_ID}.ListLayersActivity+dev`
# When unset, DA returns mock/fallback layers even if credentials exist.
APS_DA_ACTIVITY_ID=

# Optional Postgres / Redis (LOCAL_MODE ignores these)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/infraworks
REDIS_URL=redis://127.0.0.1:6379
