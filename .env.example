# Local MVP mode — in-memory/file store, mocked APS Model Derivative
LOCAL_MODE=1

# Default CRS for LDIP / Al Narjis
DEFAULT_EPSG=32638

# Ports
API_PORT=8787
# Next.js reads PORT (default 3000)
PORT=3000
MCP_PORT=8790

# Data folder: uploads, packages (artifacts), converted drawings and the project database.
# Default ./data (relative to the repo). To share it between machines, set it in each machine's
# own .env to a OneDrive folder, without quotes, e.g.
# DATA_DIR=C:\Users\<you>\OneDrive - <org>\Documents\AI\InfraWorks-Modeling-Data
DATA_DIR=./data

# Optional Autodesk APS (leave empty to keep MD mocked)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://127.0.0.1:8787/oauth/callback

# Optional Postgres / Redis (LOCAL_MODE ignores these)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/infraworks
REDIS_URL=redis://127.0.0.1:6379
