/**
 * Al Narjis: does each modelled network run in its utility corridor (IUC-DWG-10000)? Reads the network
 * layers of the shipped packages and the corridor lines of Al-Narjis-corridors-shp-v1 (DATA_DIR\exports),
 * and prints, per network, the share of its length within 1 m and 2 m of its corridor line.
 *
 *   pnpm exec tsx scripts/narjis/corridor-check.mts [--out scripts/narjis/corridor-check.md]
 */
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { corridorFit, resolveDataDir, type Line } from "@infraworks/domain";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
const exportsDir = join(resolveDataDir(root), "exports");
type Feature = { geometry: { type: string; coordinates: unknown }; properties: Record<string, unknown> };
const layer = (pkg: string, name: string): Feature[] => JSON.parse(readFileSync(join(exportsDir, pkg, "layers", `${name}.geojson`), "utf8")).features;
const lines = (fs: Feature[]): Line[] => fs.flatMap((f) => (f.geometry.type === "LineString" ? [f.geometry.coordinates as Line] : f.geometry.type === "MultiLineString" ? (f.geometry.coordinates as Line[]) : []));

const corridors = layer("Al-Narjis-corridors-shp-v1", "utility_corridors");
const corridorOf = (...networks: string[]) => lines(corridors.filter((f) => networks.includes(String(f.properties.network))));

const checks: { network: string; source: string; features: Feature[]; corridor: string[] }[] = [
  { network: "Storm", source: "storm_pipes (ISW-10000)", features: layer("Al-Narjis-storm-shp-v1", "storm_pipes"), corridor: ["Corridor - Storm"] },
  { network: "Sewer", source: "sewer_pipes (SewerGEMS)", features: layer("Al-Narjis-sewer-shp-v1", "sewer_pipes"), corridor: ["Corridor - Sewer"] },
  { network: "Water", source: "water_pipes (WaterGEMS)", features: layer("Al-Narjis-water-shp-v1", "water_pipes"), corridor: ["Corridor - Water"] },
  { network: "Irrigation", source: "irrigation_pipes (WaterGEMS)", features: layer("Al-Narjis-irrigation-shp-v1", "irrigation_pipes"), corridor: ["Corridor - Irrigation", "Corridor - Irrigation Secondary"] },
  { network: "Irrigation control cable", source: "irrigation_control_cable (IRW-10000)", features: layer("Al-Narjis-irrigation-dwg-shp-v1", "irrigation_control_cable"), corridor: ["Corridor - Irrigation", "Corridor - Irrigation Secondary"] },
  { network: "Electrical MV", source: "mv_cables (IMV-10000)", features: layer("Al-Narjis-dry-shp-v1", "mv_cables"), corridor: ["Corridor - Electrical MV"] },
  { network: "Electrical LV", source: "lv_cables, cables (ILV-10000)", features: layer("Al-Narjis-dry-shp-v1", "lv_cables").filter((f) => f.properties.conn_type !== "House Connection"), corridor: ["Corridor - Electrical LV"] },
  { network: "LV house connections", source: "lv_cables, house connections", features: layer("Al-Narjis-dry-shp-v1", "lv_cables").filter((f) => f.properties.conn_type === "House Connection"), corridor: ["Corridor - House Connection", "Corridor - Electrical LV"] },
  { network: "Telecom", source: "telecom_ducts (ITE-10000)", features: layer("Al-Narjis-dry-shp-v1", "telecom_ducts"), corridor: ["Corridor - Telecom"] },
  { network: "Security", source: "security_ducts (IIC-13000)", features: layer("Al-Narjis-dry-shp-v1", "security_ducts"), corridor: ["Corridor - Telecom"] },
];

const rows = checks.map((c) => {
  const net = lines(c.features), cor = corridorOf(...c.corridor);
  const a = corridorFit(net, cor, { tolerance: 1 }), b = corridorFit(net, cor, { tolerance: 2 });
  return { ...c, length: a.length, within1: a.share, within2: b.share, median: a.median, p90: a.p90, linesOff: a.linesOff, lines: net.length, corridorLength: cor.reduce((s, l) => s + l.slice(1).reduce((t, p, i) => t + Math.hypot(p[0]! - l[i]![0]!, p[1]! - l[i]![1]!), 0), 0) };
});
const pct = (v: number) => `${(v * 100).toFixed(0)} %`;
const table = [
  "| Network | Modelled from | Length (m) | Within 1 m | Within 2 m | Median offset (m) | 90 % offset (m) | Lines never on it | Corridor (m) |",
  "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
  ...rows.map((r) => `| ${r.network} | ${r.source} | ${r.length.toFixed(0)} | ${pct(r.within1)} | ${pct(r.within2)} | ${r.median.toFixed(2)} | ${r.p90.toFixed(2)} | ${r.linesOff} of ${r.lines} | ${r.corridorLength.toFixed(0)} (${r.corridor.join(", ")}) |`),
].join("\n");
process.stdout.write(table + "\n");
const out = process.argv.indexOf("--out");
if (out >= 0) writeFileSync(resolve(process.argv[out + 1]!), `# Al Narjis: networks against their utility corridors (IUC-DWG-10000)\n\nGenerated by \`scripts/narjis/corridor-check.mts\` from the packages in DATA_DIR\\exports. Plan only; a network sample is on its corridor when a corridor line lies within the tolerance.\n\n${table}\n`);
